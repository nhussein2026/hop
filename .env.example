NODE_ENV=development
PORT=4321
# The API only listens on this machine by default. Hop refuses to listen on another
# address (for example 0.0.0.0 or a Tailscale IP) until a password has been set.
HOST=127.0.0.1

DATABASE_URL=./storage/hop.db

# Set to true when Hop is served over HTTPS so the session cookie is never sent in plain text.
COOKIE_SECURE=false

# Directory for automatic daily JSON backups (7 daily + 4 weekly are retained)
BACKUP_DIR=./storage/backups
