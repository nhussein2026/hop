# Off-site backup settings, read by hop-offsite-backup.service.
# Copy to /etc/hop/restic.env with owner root:hop and mode 0640.

# Backblaze B2 through its S3-compatible API. Use the endpoint shown on your bucket's page.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket-name/hop
AWS_ACCESS_KEY_ID=your-b2-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key

# Cloudflare R2 instead:
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/your-bucket-name/hop

# The encryption password. Keep a copy in your password manager: without it the backups can't be read.
RESTIC_PASSWORD_FILE=/etc/hop/restic-password
