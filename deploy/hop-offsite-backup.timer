# Runs the off-site backup every night. Install with:
#   sudo cp /opt/hop/deploy/hop-offsite-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hop-offsite-backup.timer
[Unit]
Description=Nightly Hop off-site backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
# Catch up after the server was off at 03:30.
Persistent=true

[Install]
WantedBy=timers.target
