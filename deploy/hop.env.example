# Production settings for Hop, read by hop.service. Copy to /etc/hop/hop.env.
# Paths are absolute so they don't depend on the directory Hop starts in.
NODE_ENV=production

# Tailscale connects to Hop on this machine, so Hop never listens on a network interface.
HOST=127.0.0.1
PORT=4321

DATABASE_URL=/opt/hop/storage/hop.db
BACKUP_DIR=/opt/hop/storage/backups

# Hop is served over HTTPS by `tailscale serve`, so the session cookie is HTTPS-only.
COOKIE_SECURE=true
